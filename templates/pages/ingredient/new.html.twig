{% extends 'base.html.twig' %}

{% block title %}SymRecipe - Créer un ingrédient{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Création d'un ingrédient</h1>

    {# 1. ON FORCE LE POST ET LA ROUTE EN HTML PUR #}
    <form action="{{ path('ingredient_new') }}" method="POST">
        
        <div class="form-group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="form-group">
            {{ form_label(form.price) }}
            {{ form_widget(form.price) }}
            {{ form_errors(form.price) }}
        </div>

        <div class="form-group">
            {{ form_widget(form.submit) }}
        </div>

        {# 2. TRÈS IMPORTANT : Génère le token CSRF caché indispensable pour isValid() #}
        {{ form_rest(form) }}
        
    </form>
</div>
{% endblock %}